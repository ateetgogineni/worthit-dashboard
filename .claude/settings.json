{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/auto-commit.sh\" Stop 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/auto-commit.sh\" SessionEnd 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
